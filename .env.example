# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME="Ambulance Refer Checklist"
APP_VERSION=5.0.0
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th_TH
APP_DEBUG=false
APP_URL=http://localhost/emer/public
APP_ORIGIN=http://localhost/emer/public
SESSION_LIFETIME=480

# Generate with: php -r "echo password_hash(readline('Password: '), PASSWORD_DEFAULT), PHP_EOL;"
PASSWORD_HASH=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=refer_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=refer_
