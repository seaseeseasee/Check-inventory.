# Copy to .env and fill in real values. Never commit the real .env file.

APP_NAME="Ambulance Refer Checklist"
APP_VERSION=5.0.0
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th_TH
# เบอร์โทรที่ปุ่ม "ขอความช่วยเหลือ" ในหน้าตรวจเช็กโทรออก (เว้นว่าง = แสดงคำแนะนำอย่างเดียว)
HELP_PHONE=
APP_DEBUG=false
APP_URL=http://localhost/emer/public
APP_ORIGIN=http://localhost/emer/public
# true = เซิร์ฟเวอร์ไม่มี URL rewrite และชี้ URL มาที่โฟลเดอร์โปรเจกต์ (ใช้ index.php ที่ root)
#        ทุก URL จะเป็น /<path>/index.php/api/... — ปกติ (Docker / ชี้ไปที่ public/) ไม่ต้องตั้ง
APP_PATH_INFO=false
#        โหมดนี้ทั้งโฟลเดอร์โปรเจกต์เปิดผ่านเว็บได้ — .htaccess ที่ root ปิดไฟล์ลับให้ (ต้อง AllowOverride All หรือ AuthConfig)
#        ถ้าเซิร์ฟเวอร์ไม่อ่าน .htaccess: ย้ายไฟล์ .env นี้ไปไว้โฟลเดอร์แม่ของโปรเจกต์ (ระบบหาให้เอง)
#        ตั้ง SESSION_SAVE_PATH เป็นโฟลเดอร์นอกเว็บ และลบ .git / storage/backups / database ออกจากเซิร์ฟเวอร์
# โฟลเดอร์เก็บไฟล์ session (ว่าง = storage/sessions ในโปรเจกต์)
SESSION_SAVE_PATH=
SESSION_LIFETIME=480
# ไม่มีการใช้งานเกินกี่นาทีแล้วต้องเข้าสู่ระบบใหม่ (อายุสูงสุดของ session คือ 8 ชม.)
SESSION_IDLE_MINUTES=120

# Generate with: php -r "echo password_hash(readline('Password: '), PASSWORD_DEFAULT), PHP_EOL;"
PASSWORD_HASH=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=refer_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=refer_
