# Apache Configuration for Ambulance Refer Checklist
# Works with XAMPP - supports both Virtual Host and subdirectory installations

# Disable directory listing
Options -Indexes

# Must be index.php — the real PHP app
DirectoryIndex index.php

# ไม่บอกเวอร์ชัน Apache ในหน้า error (ServerTokens ตั้งได้เฉพาะใน server config — Docker: docker/apache/security.conf)
ServerSignature Off

# Security Headers
# script-src ไม่มี 'unsafe-inline': ห้ามใส่ <script> inline หรือ onclick="..." — ใช้ data-call (js/core/shell.js)
<IfModule mod_headers.c>
Header always unset X-Powered-By
Header unset X-Powered-By
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set X-Frame-Options "DENY"
Header always set Cache-Control "no-store"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Rewrite rules for SPA - supports both Virtual Host and subdirectory installs.
# The final fallback rule is REQUIRED, not optional: public/assets/ is empty on
# purpose, so every /assets/* request must reach index.php, which reads the file
# from resources/assets and sets the correct MIME type.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle API routes
    RewriteRule ^api/(.*)$ index.php [QSA,L]

    # Serve static files directly when they physically exist
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Fallback to index.php for SPA routes and assets served from resources/
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Prevent access to sensitive files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|log|sql|bak|backup)$">
    Require all denied
</FilesMatch>

# Deny direct browser access to source/config directories (parent of public/)
RewriteRule ^(config|storage|database|tests|resources|app)/ - [F,L]
