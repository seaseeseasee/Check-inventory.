# Copy this to .env (same folder as compose.yaml) before running `docker compose up`.
# Never commit the real .env — only this example file is tracked.
#
# These values are for the LOCAL Docker test environment only. They are
# separate from, and do not touch, the XAMPP installation or its database.

APP_NAME="Ambulance Refer Checklist"
APP_VERSION=5.0.0
APP_TIMEZONE=Asia/Bangkok
APP_LOCALE=th_TH
# เบอร์โทรที่ปุ่ม "ขอความช่วยเหลือ" ในหน้าตรวจเช็กโทรออก (เว้นว่าง = แสดงคำแนะนำอย่างเดียว)
HELP_PHONE=
APP_DEBUG=false

# Document Root is public/ directly in Docker (no /public suffix like the
# XAMPP subdirectory install) — must match APP_PORT below.
APP_URL=http://localhost:8080
APP_ORIGIN=http://localhost:8080

SESSION_LIFETIME=480
# ไม่มีการใช้งานเกินกี่นาทีแล้วต้องเข้าสู่ระบบใหม่ (อายุสูงสุดของ session คือ 8 ชม.)
SESSION_IDLE_MINUTES=120
# Generate with: php -r "echo password_hash(readline('Password: '), PASSWORD_DEFAULT), PHP_EOL;"
PASSWORD_HASH=

# ---------- Database — service name "db", never "localhost"/"127.0.0.1" ----------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=refer_system
DB_USERNAME=refer_app
DB_PASSWORD=change-me-before-first-run
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=refer_

# ---------- Values compose.yaml reads to configure the db/phpmyadmin services ----------
# (duplicated here on purpose: MySQL/MariaDB images read these exact names from
#  the container environment — the app itself only reads the DB_* vars above)
MYSQL_DATABASE=refer_system
MYSQL_USER=refer_app
MYSQL_PASSWORD=change-me-before-first-run
MYSQL_ROOT_PASSWORD=change-me-too-root

# ---------- Host ports (change here if 8080/8081 are already used) ----------
APP_PORT=8080
PHPMYADMIN_PORT=8081
